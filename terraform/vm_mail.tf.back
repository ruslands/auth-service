
resource "yandex_compute_instance" "vm-2" {
  allow_stopping_for_update = true
  name                      = "mail"
  platform_id               = "standard-v3"
  zone                      = "ru-central1-b"
  resources {
    cores         = "2"
    memory        = "4"
    core_fraction = "100"
  }

  boot_disk {
    initialize_params {
      image_id = "fd8i3uauimpm750kd9vh"
      size     = "100"
      type     = "network-ssd"
    }
  }

  secondary_disk {
    disk_id = yandex_compute_disk.data_disk_mail.id
  }

  network_interface {
    subnet_id = "e2lpg52vf357d83h50p3"
    nat       = true
  }

  metadata = {
    user-data          = "${file("cloud-init_mail.yaml")}"
    serial-port-enable = "1"
  }
}
resource "yandex_compute_disk" "data_disk_mail" {
  name       = "data-disk-mail"
  type       = "network-hdd"
  zone       = "ru-central1-b"
  size       = "500"
  block_size = "4096"
}